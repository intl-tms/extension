{
  "manifest_version": 3,
  "name": "Intl TMS",
  "description": "Edit a website's translations directly on the page.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Intl TMS", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'"
  }
}
